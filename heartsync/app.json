{
  "expo": {
    "name": "HeartSync",
    "slug": "heartsync",
    "scheme": "heartsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "package": "com.nhocbinhbo99.heartsync",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF7F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "HeartSync chỉ dùng ảnh bạn chọn cho hồ sơ của bạn."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeartSync chỉ dùng vị trí gần đúng khi bạn bật lọc khoảng cách."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withWindowsNativeBuild"
    ],
    "extra": {
      "eas": {
        "projectId": "2338b6bc-b74a-4661-b45c-f0d3d2f1c529"
      }
    }
  }
}
